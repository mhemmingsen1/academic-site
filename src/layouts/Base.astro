---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Used to highlight the active nav item. One of: 'home' | 'research' | 'grants' | 'teaching' */
  current?: 'home' | 'research' | 'talks' | 'grants' | 'teaching';
}

const { title, description, current } = Astro.props;
const fullTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <!-- Fonts: EB Garamond (display) + Source Serif 4 (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    {site.gaMeasurementId && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`}
        ></script>
        <script is:inline define:vars={{ gaId: site.gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <div class="page-frame">
      <header class="site-header">
        <div class="site-header-inner">
          <nav class="site-nav" aria-label="Primary">
  <a href={`${base}/`}                 aria-current={current === 'home'     ? 'page' : undefined}>Home</a>
  <a href={`${base}/research/`}        aria-current={current === 'research' ? 'page' : undefined}>Research</a>
  <a href={`${base}/talks/`}           aria-current={current === 'talks'    ? 'page' : undefined}>Talks</a>
  <a href={`${base}/grants/`}          aria-current={current === 'grants'   ? 'page' : undefined}>Grants</a>
  <a href={`${base}/teaching/`}        aria-current={current === 'teaching' ? 'page' : undefined}>Teaching</a>
</nav>
        </div>
      </header>

      <main class="container">
        <slot />
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {site.name}</p>
      </footer>
    </div>
  </body>
</html>