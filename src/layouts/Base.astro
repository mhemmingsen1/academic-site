---
import '../styles/global.css';
import { site } from '../data/site';
import { t } from '../i18n/t';
import { type Lang, langNames, langPrefix, languages } from '../i18n/config';
import { ui } from '../i18n/ui';

type PageKey = 'home' | 'research' | 'talks' | 'grants' | 'teaching';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  title: string;
  description?: string;
  /** Highlights the active nav item. Same as pageKey. */
  current?: PageKey;
}

const { lang, pageKey, title, description, current = pageKey } = Astro.props;
const fullTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Build a path for a given page in a given language.
//   home, en  → /            research, en → /research/
//   home, zh  → /zh/         research, zh → /zh/research/
function pagePath(key: PageKey, l: Lang): string {
  const prefix = langPrefix(l);            // '' for en, 'zh' for zh
  const langSeg = prefix ? `/${prefix}` : '';
  const pageSeg = key === 'home' ? '' : `/${key}`;
  const path = `${base}${langSeg}${pageSeg}/`;
  // collapse any accidental double slashes, keep it tidy
  return path.replace(/\/{2,}/g, '/');
}

// The languages to offer in the toggle: every language except the current one.
const otherLangs = languages.filter((l) => l !== lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <!-- Fonts: EB Garamond (display) + Source Serif 4 (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    {site.gaMeasurementId && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`}
        ></script>
        <script is:inline define:vars={{ gaId: site.gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <div class="page-frame">
      <header class="site-header">
        <div class="site-header-inner">
          <nav class="site-nav" aria-label="Primary">
            <a href={pagePath('home', lang)}     aria-current={current === 'home'     ? 'page' : undefined}>{t(ui.nav.home, lang)}</a>
            <a href={pagePath('research', lang)}  aria-current={current === 'research' ? 'page' : undefined}>{t(ui.nav.research, lang)}</a>
            <a href={pagePath('talks', lang)}     aria-current={current === 'talks'    ? 'page' : undefined}>{t(ui.nav.talks, lang)}</a>
            <a href={pagePath('grants', lang)}    aria-current={current === 'grants'   ? 'page' : undefined}>{t(ui.nav.grants, lang)}</a>
            <a href={pagePath('teaching', lang)}  aria-current={current === 'teaching' ? 'page' : undefined}>{t(ui.nav.teaching, lang)}</a>
          </nav>

          <div class="lang-toggle">
            {otherLangs.map((l) => (
              <a href={pagePath(pageKey, l)} hreflang={l}>{langNames[l]}</a>
            ))}
          </div>
        </div>
      </header>

      <main class="container">
        <slot />
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {site.name}</p>
      </footer>
    </div>
  </body>
</html>