---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { site } from '../../data/site';
import { t } from '../../i18n/t';
---

<Base lang="ja" current="home" pageKey="home"
      title={site.name}
      description={`${site.name} — ${t(site.role, 'ja')}, ${t(site.affiliation, 'ja')}.`}>
  <Home lang="ja" />
</Base>