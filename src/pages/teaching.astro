---
import Base from '../layouts/Base.astro';
import { courses, pedagogy } from '../data/teaching';

const allTags = Array.from(new Set(courses.flatMap((c) => c.tags ?? []))).sort();
---

<Base title="Teaching" current="teaching" description="Courses taught and pedagogical innovations.">
  <div>
    {pedagogy.length > 0 && (
      <section class="pedagogy-section">
        <h2>Pedagogy &amp; Assignments</h2>
        <ul class="entries">
          {pedagogy.map((p) => (
            <li class="entry">
              <details class="pedagogy-disclosure">
                <summary>
                  <span class="pedagogy-title">{p.title}</span>
                </summary>
                <p class="pedagogy-desc" set:html={p.description}></p>
                {p.link && (
                  <p class="pedagogy-link-row">
                    <a class="pedagogy-link" href={p.link} target="_blank" rel="noopener">View assignment (PDF)</a>
                  </p>
                )}
              </details>
            </li>
          ))}
        </ul>
      </section>
    )}
    <section class="courses-section">
      <h2>Courses</h2>
      <p class="courses-note">Syllabi available on request.</p>

      {allTags.length > 0 && (
        <div class="filter-bar" role="group" aria-label="Filter courses by topic">
          <span class="filter-label">Topic:</span>
          <button class="filter-chip" data-tag="__all" aria-pressed="true">All</button>
          {allTags.map((tag) => (
            <button class="filter-chip" data-tag={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>
      )}

      <ul class="course-list" id="course-list">
        {courses.map((c) => (
          <li class="course" data-tags={(c.tags ?? []).join('|')}>
            {c.syllabus
              ? <a class="course-title" href={c.syllabus} target="_blank" rel="noopener">{c.title}</a>
              : <span class="course-title">{c.title}</span>}
            {c.description && <> — <span class="course-desc">{c.description}</span></>}
          </li>
        ))}
      </ul>

      <p id="course-empty" style="display:none; color: var(--ink-soft); font-style: italic; margin-top: 2rem;">
        No courses match this topic.
      </p>
    </section>
  </div>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const courseItems = document.querySelectorAll<HTMLLIElement>('#course-list .course');
  const empty = document.getElementById('course-empty');

  function applyFilter(tag: string) {
    let visible = 0;
    courseItems.forEach((item) => {
      const tags = (item.dataset.tags || '').split('|').filter(Boolean);
      const show = tag === '__all' || tags.includes(tag);
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.style.display = visible === 0 ? '' : 'none';
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      applyFilter(chip.dataset.tag || '__all');
    });
  });
</script>