---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photoSrc = site.photo ? `${base}${site.photo}` : '';
---

<Base title={site.name} current="home" description={`${site.name} — ${site.role}, ${site.affiliation}.`}>
  <div class="measure">
    <div class="home-hero">
      <div class="home-hero-text">
        <h1>{site.name}</h1>
        <p>
          {site.role}<br />
          {site.affiliation}<br />
          {site.location}
        </p>
        {site.involvements.length > 0 && (
          <p class="home-involvements">
            {site.involvements.filter(item => item.url).map((item, i, arr) => (
              <>
                <a href={item.url} target="_blank" rel="noopener">{item.label}</a>
                {i < arr.length - 1 && <span class="sep">·</span>}
              </>
            ))}
          </p>
        )}
      </div>
      {site.photo && (
        <img
          class="home-photo"
          src={photoSrc}
          alt={site.photoAlt || site.name}
          width="152"
          height="200"
        />
      )}
    </div>

    {site.positionDescription.length > 0 && (
      <section class="home-section">
        <p>
          {site.positionDescription.map((line, i) => (
            <>
              {line}
              {i < site.positionDescription.length - 1 && <br />}
            </>
          ))}
        </p>
      </section>
    )}

    {site.education.length > 0 && (
      <section class="home-section">
        <h2>Education</h2>
        <ul class="home-list">
          {site.education.map((e) => (
            <li>
              {e.degree}, {e.institution}{e.year && ` (${e.year})`}
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="home-elsewhere">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span class="sep">·</span>
      <a href={site.philpeople} target="_blank" rel="noopener">PhilPeople</a>
      <span class="sep">·</span>
      <a href={site.orcid} target="_blank" rel="noopener">ORCID</a>
      {site.googleScholar && (
        <>
          <span class="sep">·</span>
          <a href={site.googleScholar} target="_blank" rel="noopener">Google Scholar</a>
        </>
      )}
      {site.philpapers && (
        <>
          <span class="sep">·</span>
          <a href={site.philpapers} target="_blank" rel="noopener">PhilPapers</a>
        </>
      )}
      {site.cv && (
        <>
          <span class="sep">·</span>
          <a href={site.cv}>CV</a>
        </>
      )}
    </div>
  </div>
</Base>