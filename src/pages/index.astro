---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { site } from '../data/site';
import { t } from '../i18n/t';
---

<Base lang="en" current="home" pageKey="home"
      title={site.name}
      description={`${site.name} — ${t(site.role, 'en')}, ${t(site.affiliation, 'en')}.`}>
  <Home lang="en" />
</Base>