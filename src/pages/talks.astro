---
import Base from '../layouts/Base.astro';
import { talks } from '../data/talks';

const sorted = [...talks].sort((a, b) => b.year - a.year);

const byYear = new Map<number, typeof talks>();
for (const t of sorted) {
  if (!byYear.has(t.year)) byYear.set(t.year, []);
  byYear.get(t.year)!.push(t);
}
const years = Array.from(byYear.keys());

const allTags = Array.from(
  new Set(sorted.flatMap((t) => t.tags ?? []))
).sort();
---

<Base title="Talks" current="talks" description="Conference presentations and invited talks.">
  <div>
    <h1>Talks</h1>

    {allTags.length > 0 && (
      <div class="filter-bar" role="group" aria-label="Filter talks by topic">
        <span class="filter-label">Topic:</span>
        <button class="filter-chip" data-tag="__all" aria-pressed="true">All</button>
        {allTags.map((tag) => (
          <button class="filter-chip" data-tag={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>
    )}

    <div class="pub-years">
      {years.map((year) => (
        <div class="pub-year-group" data-year={year}>
          <div class="pub-year-label">{year}</div>
          <ul class="entries">
            {byYear.get(year)!.map((t) => (
              <li class="entry" data-tags={(t.tags ?? []).join('|')}>
                <p class="entry-title">
                  {t.link
                    ? <a href={t.link} target="_blank" rel="noopener">{t.title}</a>
                    : <span>{t.title}</span>}
                  {t.isInvited && <span class="talk-invited">Invited</span>}
                </p>
                <p class="entry-meta">
                  {t.venue}{t.date && <>, {t.date}</>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p id="talk-empty" style="display:none; color: var(--ink-soft); font-style: italic; margin-top: 2rem;">
      No talks match this topic.
    </p>
  </div>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const yearGroups = document.querySelectorAll<HTMLDivElement>('.pub-year-group');
  const empty = document.getElementById('talk-empty');

  function applyFilter(tag: string) {
    let totalVisible = 0;

    yearGroups.forEach((group) => {
      const entries = group.querySelectorAll<HTMLLIElement>('.entry');
      let visibleInGroup = 0;

      entries.forEach((entry) => {
        const tags = (entry.dataset.tags || '').split('|').filter(Boolean);
        const show = tag === '__all' || tags.includes(tag);
        entry.style.display = show ? '' : 'none';
        if (show) {
          visibleInGroup++;
          totalVisible++;
        }
      });

      group.style.display = visibleInGroup === 0 ? 'none' : '';
    });

    if (empty) empty.style.display = totalVisible === 0 ? '' : 'none';
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      applyFilter(chip.dataset.tag || '__all');
    });
  });
</script>